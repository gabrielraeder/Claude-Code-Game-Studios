; Engine configuration file.
; run/main_scene is intentionally unset: /dev-story or the user sets it once a scene exists.

config_version=5

[application]

config/name="Dogworks Racing: Kennel Kingdom"
run/main_scene="res://src/legacy/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/dogworks_core/plugin.cfg")

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=false
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
3d/run_on_separate_thread=false
jolt_physics_3d/queries/enable_ray_cast_face_index=true

[rendering]

renderer/rendering_method="forward_plus"
