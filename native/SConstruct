#!/usr/bin/env python
# dogworks_core build (ADR-0007 sections 4, 6, 7). One variant per scons run:
#   scons variant=debug|release|bench
# tools/build_native.sh runs all three through tools/build_native.bat (vcvars64 wrapper).
#
# Pinned flags (determinism, ADR-0007 section 4): MSVC /fp:precise, no /fp:fast, no /arch:AVX2
# (SSE2 baseline, so no FMA contraction), static CRT (/MT, use_static_cpp=yes).
# Each variant has its own folder native/obj/<variant>/ (godot-cpp objects, our objects, the
# generated build_marker.cpp, the linked DLL in dist/). tools/build_native.sh moves the DLL from dist/
# into addons/dogworks_core/bin/ only after a successful link, so a DLL a Godot process holds is
# never the link target.
#   debug   template_debug,   hot reload on  (what the editor loads)
#   release template_release, hot reload OFF (what an export ships)
#   bench   template_release, hot reload on  (copied over the debug name by --bench, ADR-0007 section 8)
import os

VARIANTS = {
    "debug": {"target": "template_debug", "hot_reload": "yes", "symbols": "yes", "dll": "dogworks_core.windows.template_debug.x86_64.dll"},
    "release": {"target": "template_release", "hot_reload": "no", "symbols": "no", "dll": "dogworks_core.windows.template_release.x86_64.dll"},
    "bench": {"target": "template_release", "hot_reload": "yes", "symbols": "no", "dll": "dogworks_core.windows.bench.x86_64.dll"},
}
variant = ARGUMENTS.get("variant", "debug")
if variant not in VARIANTS:
    raise SystemExit("variant must be one of: " + ", ".join(VARIANTS))
cfg = VARIANTS[variant]

# Settings godot-cpp reads from ARGUMENTS.
ARGUMENTS.setdefault("platform", "windows")
ARGUMENTS.setdefault("arch", "x86_64")
ARGUMENTS["target"] = cfg["target"]
ARGUMENTS["use_hot_reload"] = cfg["hot_reload"]
ARGUMENTS["debug_symbols"] = cfg["symbols"]
ARGUMENTS["use_static_cpp"] = "yes"
ARGUMENTS["gdextension_dir"] = "api"
ARGUMENTS["custom_api_file"] = "api/extension_api.json"

SConsignFile("obj/sconsign.dblite")
vdir = "obj/" + variant

env = SConscript("godot-cpp/SConstruct", variant_dir=vdir + "/godot-cpp", duplicate=0)

env.Append(CPPPATH=[Dir("#src")])
if env.get("is_msvc", False):
    # /fp:precise is MSVC's default; stated so the pinned command line shows it. /fp:fast and
    # /arch:AVX2 are deliberately absent.
    env.Append(CCFLAGS=["/fp:precise"])

# The only generated source: one literal, never a CPPDEFINES value (ADR-0007 section 7).
sh = os.environ.get("DOGWORKS_SH", "0" * 64)
fh = os.environ.get("DOGWORKS_FH", "0" * 64)
marker_target = variant
marker_text = '/* Generated by native/SConstruct. Do not edit. */\nextern const char dogworks_build_marker[] = "DOGWORKS_BUILD:%s:%s:%s:END";\n' % (marker_target, sh, fh)
marker_path = os.path.join(Dir("#obj").abspath, variant, "build_marker.cpp")
os.makedirs(os.path.dirname(marker_path), exist_ok=True)
old = None
if os.path.exists(marker_path):
    with open(marker_path, "r", newline="") as f:
        old = f.read()
if old != marker_text:
    with open(marker_path, "w", newline="") as f:
        f.write(marker_text)

src_root = Dir("#src").abspath
sources = []
for dirpath, _dirs, files in os.walk(src_root):
    for name in sorted(files):
        if name.endswith(".cpp"):
            rel = os.path.relpath(os.path.join(dirpath, name), src_root).replace("\\", "/")
            sources.append(File("#src/" + rel))
sources.sort(key=lambda n: n.path)
def _obj_path(node):
    """obj/<variant>/o/<path below src, with forward slashes>.obj (slashes normalised before the strip)."""
    rel = node.path.replace("\\", "/")
    if rel.startswith("src/"):
        rel = rel[len("src/"):]
    return vdir + "/o/" + os.path.splitext(rel)[0] + ".obj"


objects = [env.SharedObject(target=_obj_path(s), source=s) for s in sources]
objects.append(env.SharedObject(target=vdir + "/o/build_marker.obj", source=File(marker_path)))

dll = os.path.join(vdir, "dist", cfg["dll"])
# PDB is set only for the variant that wants symbols: setting it makes SCons add /Z7 to every compile line.
if env.get("is_msvc", False) and cfg["symbols"] == "yes":
    env["PDB"] = os.path.splitext(dll)[0] + ".pdb"
library = env.SharedLibrary(target=File(dll), source=objects, SHLIBPREFIX="")
Default(library)
